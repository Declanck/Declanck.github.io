---
---

<section id="contact">
  <div class="container">
    <h2 class="section-title">联系我</h2>
    <div class="contact-wrapper load-hidden">
      <p class="contact-wrapper__text">
        有项目合作想法？或者想交流摄影技巧？<br />
        欢迎通过以下方式联系我
      </p>
      <div class="contact-methods">
        <a
          rel="noreferrer"
          target="_blank"
          class="contact-btn"
          href="mailto:your.email@example.com"
        >
          <i class="fas fa-envelope"></i>
          <span>your.email@example.com</span>
        </a>
        <a
          rel="noreferrer"
          target="_blank"
          class="contact-btn"
          href="https://github.com/Declanck"
        >
          <i class="fab fa-github"></i>
          <span>GitHub</span>
        </a>
        <a rel="noreferrer" target="_blank" class="contact-btn" href="#wechat">
          <i class="fab fa-weixin"></i>
          <span>微信公众号</span>
        </a>
      </div>
    </div>
  </div>
</section>

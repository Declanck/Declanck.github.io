---
---

<section id="wechat" class="section-wechat">
  <div class="container">
    <h2 class="section-title load-hidden">微信公众号</h2>
    <p class="section-subtitle load-hidden">真实 / 连接 / 创造</p>

    <div class="row wechat-wrapper">
      <div class="col-md-5 col-sm-12">
        <div class="wechat-qr load-hidden">
          <div class="qr-container">
            <img
              src="/assets/wechat-qr.jpg"
              alt="微信公众号二维码"
              class="qr-image"
            />
            <p class="qr-hint">扫码关注公众号</p>
          </div>
        </div>
      </div>
      <div class="col-md-7 col-sm-12">
        <div class="wechat-content load-hidden">
          <h3 class="wechat-name">
            <i class="fab fa-weixin"></i>
            WetPinehole
          </h3>
          <p class="wechat-desc">
            分享产品思考、AI探索、影视鉴赏与生活感悟。用真实的视角连接更多有趣的灵魂，一起创造有价值的内容。
          </p>

          <div class="wechat-highlights">
            <h4>精选内容</h4>
            <div class="highlight-cards">
              <div class="highlight-card">
                <i class="fas fa-robot"></i>
                <h5>AI探索</h5>
                <p>AI工具、产品思考</p>
              </div>
              <div class="highlight-card">
                <i class="fas fa-film"></i>
                <h5>影视鉴赏</h5>
                <p>电影、电视剧分享</p>
              </div>
              <div class="highlight-card">
                <i class="fas fa-book-open"></i>
                <h5>生活随笔</h5>
                <p>成长感悟、日常记录</p>
              </div>
            </div>
          </div>

          <div class="wechat-stats">
            <div class="stat-item">
              <span class="stat-number">100+</span>
              <span class="stat-label">原创文章</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">1000+</span>
              <span class="stat-label">关注读者</span>
            </div>
            <div class="stat-item">
              <span class="stat-number">50+</span>
              <span class="stat-label">技术教程</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
